+/* Alci: the front window moved from move_ox, move_oy: its inside and title
+   bar copied in video memory, the desktop it uncovers and the icons there
+   drawn (not over the window), then the rest of its frame. Another
+   window near it, or a dialog or a menu: the rows. */
+static unsigned char
+meets(unsigned char ax1, unsigned char ax2, unsigned char ay1,
+      unsigned char ay2, unsigned char bx1, unsigned char bx2,
+      unsigned char by1, unsigned char by2)
+{
+  return ax1 < bx2 && bx1 < ax2 && ay1 < by2 && by1 < ay2;
+}
+/* the desktop and its icons in x1 .. x2 - 1, y1 .. y2 - 1; the icons
+   without the cells under the window (ctk_gfx_skip) */
+static void
+desk_part(unsigned char x1, unsigned char x2, unsigned char y1,
+          unsigned char y2)
+{
+  struct ctk_widget *widget;
+  if(x1 >= x2 || y1 >= y2) {
+    return;
+  }
+  ctk_gfx_desk_rect(x1, x2, y1, y2);
+  for(widget = desktop_window.active; widget != NULL; widget = widget->next) {
+    unsigned char a1, a2, b1, b2;
+    ctk_gfx_icon_extent(widget, &a1, &a2, &b1, &b2);
+    if(meets(a1, a2, b1, b2, x1, x2, y1, y2)) {
+      ctk_draw_widget(widget, 0, 1, height);
+    }
+  }
+}
+static void
+do_move(void)
+{
+  struct ctk_window *w = windows, *w2;
+  struct ctk_widget *wi;
+  unsigned char ox1, ox2, oy1, oy2, nx1, nx2, ny1, ny2, ux1, ux2, uy1, uy2;
+  unsigned char s1, s2, whole, x = w->x, y = w->y;
+  signed char dx = x - move_ox, dy = y - move_oy;
+
+  ctk_gfx_window_extent(w, &nx1, &nx2, &ny1, &ny2);
+  w->x = move_ox;
+  w->y = move_oy;
+  ctk_gfx_window_extent(w, &ox1, &ox2, &oy1, &oy2);
+  w->x = x;
+  w->y = y;
+  ux1 = ox1 < nx1 ? ox1 : nx1;
+  ux2 = ox2 > nx2 ? ox2 : nx2;
+  uy1 = oy1 < ny1 ? oy1 : ny1;
+  uy2 = oy2 > ny2 ? oy2 : ny2;
+  if(dialog != NULL
+#if CTK_CONF_MENUS
+     || menus.open != NULL
+#endif /* CTK_CONF_MENUS */
+     || move_ox + w->w + 2 > width || x + w->w + 2 > width
+     || oy2 >= height || ny2 >= height) {  /* on the status bar: all */
+    do_redraw_all(1, height);
+    return;
+  }
+  for(w2 = w->next; w2 != NULL; w2 = w2->next) {
+    unsigned char a1, a2, b1, b2;
+    ctk_gfx_window_extent(w2, &a1, &a2, &b1, &b2);
+    if(meets(a1, a2, b1, b2, ux1, ux2, uy1, uy2)) {
+      do_redraw_all(uy1, uy2);
+      return;
+    }
+  }
+  whole = 0;
+  if(dx != 0 || dy != 0) {
+    /* the whole window with its frame and shadow when the desktop round it
+       is the same at both places and no icon is under it */
+    whole = ctk_gfx_copy_whole(ox1, ox2, oy1, oy2, dx, dy);
+    for(wi = desktop_window.active; whole && wi != NULL; wi = wi->next) {
+      unsigned char a1, a2, b1, b2;
+      ctk_gfx_icon_extent(wi, &a1, &a2, &b1, &b2);
+      if(meets(a1, a2, b1, b2, ox1, ox2, oy1, oy2) ||
+         meets(a1, a2, b1, b2, nx1, nx2, ny1, ny2)) {
+        whole = 0;
+      }
+    }
+  }
+  if(whole) {
+    ctk_gfx_move(ox1, ox2, oy1, oy2, dx, dy);
+  } else if(dx != 0 || dy != 0) {
+    /* the inside and the title bar (not its corners, which the desktop
+       shows through) */
+    ctk_gfx_move(move_ox + 1, move_ox + 1 + w->w, move_oy + 1,
+                 move_oy + 2 + w->h, dx, dy);
+  }
+  if(dx != 0 || dy != 0) {
+    ctk_gfx_skip(nx1, nx2, ny1, ny2);
+    if(!meets(ox1, ox2, oy1, oy2, nx1, nx2, ny1, ny2)) {
+      desk_part(ox1, ox2, oy1, oy2);
+    } else {
+      /* the rows it left, then the columns it left in the rows it keeps */
+      if(oy1 < ny1) {
+        desk_part(ox1, ox2, oy1, ny1);
+      }
+      if(oy2 > ny2) {
+        desk_part(ox1, ox2, ny2, oy2);
+      }
+      s1 = oy1 > ny1 ? oy1 : ny1;
+      s2 = oy2 < ny2 ? oy2 : ny2;
+      if(ox1 < nx1) {
+        desk_part(ox1, nx1, s1, s2);
+      }
+      if(ox2 > nx2) {
+        desk_part(nx2, ox2, s1, s2);
+      }
+    }
+    ctk_gfx_skip(0, 0, 0, 0);
+  }
+  if(whole && !move_done && !stale_is(w)) {
+    return;                             /* the frame came along */
+  }
+  move_done = 0;
+  if(dx != 0 || dy != 0) {
+    ctk_gfx_skip(x + 1, x + 1 + w->w, y + 1, y + 2);   /* the bar was copied */
+  }
+  ctk_gfx_window_frame(w, mode == CTK_MODE_WINDOWMOVE ? 0 : CTK_FOCUS_WINDOW,
+                       dx != 0 || dy != 0);
+  ctk_gfx_skip(0, 0, 0, 0);
+  if(mode != CTK_MODE_WINDOWMOVE && stale_is(w)) {
+    /* changes it missed while it moved */
+    ctk_draw_clear_window(w, CTK_FOCUS_WINDOW, 1, height);
+    ctk_draw_window(w, CTK_FOCUS_WINDOW, 1, height, 1);
+    stale_clear(w);
+  }
+}
+/*-----------------------------------------------------------------------------------*/
+/* Alci: a window moved by a program (ctk_window_move only sets x and y);
+   the one in front is copied */
+void
+ctk_window_moveto(struct ctk_window *w, unsigned char x, unsigned char y)
+{
+  /* kept on the screen, as the arrow keys keep it */
+  if(x > width - w->w - 2) {
+    x = width - w->w - 2;
+  }
+  if(y > height - w->h - 4) {         /* and off the status bar */
+    y = height - w->h - 4;
+  }
+  if(w != windows || (redraw & REDRAW_ALL)) {
+    w->x = x;
+    w->y = y;
+    redraw |= REDRAW_ALL;
+    return;
+  }
+  if(!(redraw & REDRAW_MOVE)) {
+    move_ox = w->x;
+    move_oy = w->y;
+  }
+  w->x = x;
+  w->y = y;
+  redraw |= REDRAW_MOVE;
+}
+/*-----------------------------------------------------------------------------------*/
+/* Alci: the Alt-Tab switcher closed: the rows it took drawn again */
+static void
+switch_end(void)
+{
+  if(switch_sel == NULL) {
+    return;
+  }
+  switch_sel = NULL;
+  switch_draw = 0;
+  if(!switch_shown) {
+    return;                             /* never drawn: Alt went up at once */
+  }
+  switch_shown = 0;
+  if(ctk_gfx_unsave()) {
+    return;                             /* what was under it is back */
+  }
+  if(switch_y1 < redraw_y1) {
+    redraw_y1 = switch_y1;
+  }
+  if(switch_y2 > redraw_y2) {
+    redraw_y2 = switch_y2;
+  }
+  redraw |= REDRAW_ROWS;
+}
+/* Alci: 1 when no window and no dialog is open (Alt-F4 then asks to quit) */
+unsigned char
+ctk_desktop_empty(void)
+{
+  return windows == NULL && dialog == NULL;
+}
+/* Alci: the window menu (Alt-Space) closed: its rows drawn again */
+static void
+wmenu_end(void)
+{
+  if(!wmenu_on) {
+    return;
+  }
+  wmenu_on = 0;
+  wmenu_draw = 0;
+  if(!wmenu_shown) {
+    return;
+  }
+  wmenu_shown = 0;
+  if(ctk_gfx_unsave()) {
+    return;
+  }
+  if(wmenu_y1 < redraw_y1) {
+    redraw_y1 = wmenu_y1;
+  }
+  if(wmenu_y2 > redraw_y2) {
+    redraw_y2 = wmenu_y2;
+  }
+  redraw |= REDRAW_ROWS;
+}
+/* Alci: the window in front sent behind the others (Alt-Esc) */
+static void
+send_back(void)
+{
+  struct ctk_window *w2 = windows, *last;
+  if(w2 == NULL || w2->next == NULL) {
+    return;
+  }
+  for(last = windows; last->next != NULL; last = last->next);
+  windows = w2->next;
+  windows->prev = NULL;
+  last->next = w2;
+  w2->prev = last;
+  w2->next = NULL;
+#if CTK_CONF_MENUS
+  make_desktopmenu();
+#endif /* CTK_CONF_MENUS */
+  redraw |= REDRAW_ALL;
+}
+/* Alci: the windows that missed changes while they could not be drawn */
+static void
+stale_mark(struct ctk_window *w)
+{
+  unsigned char i;
+  if(w == NULL || w == &desktop_window || stale_is(w)) {
+    return;
+  }
+  for(i = 0; i < 4; ++i) {
+    if(stale[i] == NULL) {
+      stale[i] = w;
+      return;
+    }
+  }
+  stale_all = 1;                        /* too many to keep: all of them */
+}
+static unsigned char
+stale_is(struct ctk_window *w)
+{
+  unsigned char i;
+  if(stale_all) {
+    return 1;
+  }
+  for(i = 0; i < 4; ++i) {
+    if(stale[i] == w) {
+      return 1;
+    }
+  }
+  return 0;
+}
+static void
+stale_clear(struct ctk_window *w)
+{
+  unsigned char i;
+  for(i = 0; i < 4; ++i) {
+    if(stale[i] == w) {
+      stale[i] = NULL;
+    }
+  }
+}
