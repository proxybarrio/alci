From 7ecbce5d14fa85e1a589d154503c4bcd1f516302 Mon Sep 17 00:00:00 2001
From: Claude <noreply@anthropic.com>
Date: Fri, 27 Nov 2026 16:54:54 +0000
Subject: [PATCH] [kernel] Don't draw disk wheel while console is held for
 graphics

The BIOS disk driver spins a character in the top right corner of the
text screen during I/O and writes a space there when done. When a
program holds the console with DCGET_GRAPH and the screen is in a
graphics mode, these bytes land in the picture: on CGA a few stray
pixels at the right end of the top pixel rows, each time the program
reads the disk (e.g. listing a directory).

Keep the wheel off from DCGET_GRAPH until DCREL_GRAPH.

Tested in QEMU (CGA) with a desktop program listing a directory: the
corner is now unchanged; without the fix it shows the stray pixels.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 elks/arch/i86/drivers/char/console.c | 4 ++++
 elks/arch/i86/kernel/timer.c         | 5 +++--
 elks/include/linuxmt/timer.h         | 1 +
 3 files changed, 8 insertions(+), 2 deletions(-)

diff --git a/elks/arch/i86/drivers/char/console.c b/elks/arch/i86/drivers/char/console.c
index 2125085..e62e05b 100644
--- a/elks/arch/i86/drivers/char/console.c
+++ b/elks/arch/i86/drivers/char/console.c
@@ -1,5 +1,7 @@
 /* shared console routines for Direct and BIOS consoles - #include in console drivers*/
 
+#include <linuxmt/timer.h>
+
 static void WriteChar(Console * C, int c)
 {
     /* check for graphics lock */
@@ -372,6 +374,7 @@ static int Console_ioctl(struct tty *tty, int cmd, char *arg)
             }
 #endif
             glock = C;
+            spin_graph = 1;     /* disk wheel would write into graphics screen */
             return 0;
         }
         return -EBUSY;
@@ -400,6 +403,7 @@ static int Console_ioctl(struct tty *tty, int cmd, char *arg)
                 SetDisplayPage(Visible[C->display]);
 #endif
             glock = NULL;
+            spin_graph = 0;
             wake_up(&glock_wait);
             return 0;
         }
diff --git a/elks/arch/i86/kernel/timer.c b/elks/arch/i86/kernel/timer.c
index 2fb37da..e567971 100644
--- a/elks/arch/i86/kernel/timer.c
+++ b/elks/arch/i86/kernel/timer.c
@@ -21,6 +21,7 @@
 
 volatile jiff_t jiffies;
 static int spin_on;
+int spin_graph;         /* console held for graphics, don't draw wheel */
 static int delaytick;
 
 #ifdef CONFIG_CPU_USAGE
@@ -106,7 +107,7 @@ void timer_bh(void)
 
 #if defined(CONFIG_CONSOLE_DIRECT) && !defined(CONFIG_ARCH_SWAN)
     /* spin timer wheel in upper right of screen*/
-    if (spin_on && !(jiffies & 7)) {
+    if (spin_on && !spin_graph && !(jiffies & 7)) {
         static unsigned char wheel[4] = {'-', '\\', '|', '/'};
         static int c;
 
@@ -118,7 +119,7 @@ void timer_bh(void)
 void spin_timer(int onflag)
 {
 #if defined(CONFIG_CONSOLE_DIRECT) && !defined(CONFIG_ARCH_SWAN)
-    if ((spin_on = onflag) == 0)
+    if ((spin_on = onflag) == 0 && !spin_graph)
         pokeb((79 + 0*80) * 2, VideoSeg, ' ');
 #endif
 }
diff --git a/elks/include/linuxmt/timer.h b/elks/include/linuxmt/timer.h
index f53e710..29dfe9d 100644
--- a/elks/include/linuxmt/timer.h
+++ b/elks/include/linuxmt/timer.h
@@ -31,6 +31,7 @@ void run_timer_list(void);
 void timer_tick(int, struct pt_regs *);
 void timer_bh(void);
 void spin_timer(int);
+extern int spin_graph;
 
 /* timer-8254.c*/
 void enable_timer_tick(void);
-- 
